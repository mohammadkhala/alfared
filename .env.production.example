# ════════════════════════════════════════════════════════════════════
# Alfared — Production .env template
# Copy to .env on production server and fill in real values.
# Generate APP_KEY with: php artisan key:generate
# ════════════════════════════════════════════════════════════════════

APP_NAME="أبناء الفريد"
APP_ENV=production
APP_KEY=                                    # required! run: php artisan key:generate
APP_DEBUG=false                             # NEVER true in production
APP_URL=https://yourdomain.com              # must be HTTPS

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error                             # only log errors in prod

# ── Database ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alfared_prod
DB_USERNAME=alfared_user
DB_PASSWORD=                                # use a strong unique password

# ── Session — HARDENED ──
SESSION_DRIVER=database
SESSION_LIFETIME=60                         # 1 hour (was 120)
SESSION_SECURE_COOKIE=true                  # HTTPS-only cookies
SESSION_HTTP_ONLY=true                      # JS can't read cookies
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=true                        # encrypt session data

# ── Queue — use Redis or DB worker, not sync ──
QUEUE_CONNECTION=database
# Run: php artisan queue:work --daemon

# ── Cache ──
CACHE_STORE=redis                           # or 'database' if no redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Mail (for password resets, etc.) ──
MAIL_MAILER=smtp
MAIL_HOST=smtp.yourprovider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Trusted proxies (if behind Cloudflare/nginx) ──
TRUSTED_PROXIES=*

# ── Filesystem ──
FILESYSTEM_DISK=public

# ── Broadcast ──
BROADCAST_CONNECTION=null

# ════════════════════════════════════════════════════════════════════
# Post-deploy checklist:
#   ✓ chmod 600 .env
#   ✓ php artisan config:cache
#   ✓ php artisan route:cache
#   ✓ php artisan view:cache
#   ✓ php artisan event:cache
#   ✓ php artisan migrate --force
#   ✓ Setup HTTPS (Let's Encrypt)
#   ✓ Run: php artisan queue:work via supervisord
#   ✓ Setup daily DB backups
#   ✓ Change Admin@2025 password
# ════════════════════════════════════════════════════════════════════
